# Optional overrides of config/settings.yaml. MIMIC-IV data may only be sent to a model
# served locally (PhysioNet DUA), so there is no API key to set for the dose runs.
# LLM_MODE=local
# LLM_PROVIDER=local_vllm
# MODEL_NAME=RedHatAI/gemma-3-12b-it-FP8-dynamic
# OPENAI_BASE_URL=http://127.0.0.1:8000/v1

# Guideline download (kg.guideline.load) through NCBI E-utilities. Optional: a key raises
# the rate limit from 3 to 10 requests per second.
NCBI_API_KEY=
NCBI_EMAIL=
