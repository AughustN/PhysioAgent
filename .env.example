LLM_MODE=api
LLM_PROVIDER=groq

# Use one key for the selected provider.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional advanced overrides. Leave unset to use config/settings.yaml providers.
# OPENAI_BASE_URL=
# MODEL_NAME=

# --- knowledge-graph build ------------------------------------------------------------
# NCBI E-utilities. Free, instant, no review: account.ncbi.nlm.nih.gov -> Account settings
# -> API Key Management. Raises the PubMed rate limit from 3 to 10 requests/second, which
# is the difference between hours and a day for kg.sources.pubmed_source.
NCBI_API_KEY=
# NCBI asks callers to identify themselves; unset is tolerated but throttled harder.
NCBI_EMAIL=

# kg.refine tier 3 only (entity/relation clustering). Not needed for --no-embeddings.
OPENAI_API_KEY=
