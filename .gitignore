# Secrets / local environment
.env
.env.*
!.env.example

# Per-developer config overrides (merged on top of settings.yaml)
config/*.local.yaml

# Python cache / tooling
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Python packaging
*.egg-info/
build/
dist/
wheelhouse/

# Runtime artifacts generated by PhysioAgent
outputs/

# MIMIC dataset + derived evaluation data (never publish patient-derived data)
eval/data/

# Evaluation run artifacts (logs, per-case stage outputs, scored results)
eval/results/

# Stray eval artifacts written outside eval/results/ when a run is launched from
# the wrong working directory (patient-derived; must never be committed)
runs/
logs/
*_cohort.csv
cohort.csv

# Logs and generated result data
*.log
*Results.csv
RequestedData.json

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Guideline documents under publisher copyright
kg/data/guideline/raw/
kg/data/guideline/guideline_passages*
kg/data/guideline/guideline_axis_eval/
kg/data/guideline/guideline_clusters*
kg/data/guideline/guideline_link_eval/
kg/data/guideline/guideline_concept_links.jsonl
kg/data/guideline/guideline_graph*
kg/data/guideline/_stale/

# Patient-level walkthroughs derived from MIMIC (DUA)
docs/raw_to_concepts_*.txt

# Third-party papers / theses (publisher copyright) and large binaries
docs/*.pdf
docs/*.pptx

# One-off dump of comments stripped from the code on 2026-10-01
historyDocs.txt

# Kept local for now, except the cohort dose runner the GreenNode server pulls.
# eval/results/ holds replies that quote patient values: it stays ignored (DUA).
eval/*
!eval/__init__.py
!eval/run_cohort_dose.py
!eval/run_cohort_rules.py
!eval/greennode/
eval/greennode/*
!eval/greennode/run_cohort_dose.sh
tests/
